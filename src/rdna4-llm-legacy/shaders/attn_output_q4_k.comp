layout(local_size_x_id = 1, local_size_y = 1, local_size_z = 1) in;

#include "common.glsl"

// O's weight matrix is [D rows, N_HEADS*HEAD_DIM cols] -- row width is
// N_HEADS*HEAD_DIM, not D. See attn_output_q8_0.comp for the full explanation
// of why the D-based stride (copy-pasted from the QKV shaders) is a real bug.
#define Q4K_SB_BYTES      144u
#define Q4K_SBS_PER_ROW   (N_HEADS * HEAD_DIM / 256u)
#define Q4K_ROW_STRIDE    (Q4K_SBS_PER_ROW * Q4K_SB_BYTES)

#define Q_BYTES  (N_HEADS * HEAD_DIM * Q4K_ROW_STRIDE)
#define K_BYTES  (N_KV_HEADS * HEAD_DIM * Q4K_ROW_STRIDE)
#define V_BYTES  (N_KV_HEADS * HEAD_DIM * Q4K_ROW_STRIDE)

#define O_BASE  pc.o_offset

float read_q4k_weight(uint base, uint row, uint col) {
    uint superblock  = col / 256u;
    uint elem_in_sb  = col & 255u;
    uint sb_start    = base + row * Q4K_ROW_STRIDE + superblock * Q4K_SB_BYTES;
    return dequant_q4_k(sb_start, elem_in_sb);
}

void main() {
    uint out_row = gl_WorkGroupID.x * (WG_SIZE_X / SUBGROUP_SIZE) + gl_SubgroupID;
    uint lane_id = gl_SubgroupInvocationID;

    if (out_row >= D) return;

    float accum = 0.0;
    for (uint k = lane_id; k < N_HEADS * HEAD_DIM; k += SUBGROUP_SIZE) {
        float x = float(hidden_in.x[k]);
        accum += x * read_q4k_weight(O_BASE, out_row, k);
    }

    float projected = warpReduceSum(accum);
    float residual  = float(scratch.s[out_row]);

    if (lane_id == 0u) {


        hidden_out.y[out_row] = float16_t(projected * pc.residual_scale + residual);


    }
}
