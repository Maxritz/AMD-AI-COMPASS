#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int8    : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16   : require  
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float32 : require
#extension GL_KHR_shader_subgroup_basic                    : require
#extension GL_KHR_shader_subgroup_arithmetic               : require
#extension GL_KHR_shader_subgroup_shuffle                  : require
#extension GL_KHR_shader_subgroup_ballot                   : require
#extension GL_KHR_shader_subgroup_clustered                : require
#extension GL_EXT_subgroup_size_control : enable
#extension GL_EXT_nonuniform_qualifier                     : require
#extension GL_EXT_scalar_block_layout                      : require
#extension GL_EXT_shader_8bit_storage                      : require
#extension GL_EXT_shader_16bit_storage                     : require
#extension GL_KHR_memory_scope_semantics                   : require

layout(local_size_x_id = 1, local_size_y = 1, local_size_z = 1) in;
#define CUSTOM_IO_BINDINGS
#include "common.glsl"

// Q6_K token embedding: reads the quantized token_embd.weight (block_q6_K) from
// set1 binding 0 and dequants each element to fp16 output.
// block_q6_K: 256 elems, 210 bytes. Dequant identical to common.glsl dequant_q6_k
// but sourced from the embedding buffer (emb.data) instead of weight_array.

layout(set = IO_SET, binding = BINDING_HIDDEN_IN, scalar) readonly buffer EmbBuf { uint8_t data[]; } emb;
layout(set = IO_SET, binding = BINDING_HIDDEN_OUT, scalar)          buffer OutBuf { float16_t y[]; } hidden_out;

#define Q6_K_BLOCK_BYTES  210u
#define Q6_K_BLOCKS_PER_D (D / 256u)
#define Q6_K_ROW_STRIDE   (Q6_K_BLOCKS_PER_D * Q6_K_BLOCK_BYTES)

float emb_dequant_q6_k(uint row, uint idx) {
    uint sb_idx    = idx / 256u;
    uint elem_in_sb = idx % 256u;
    uint block_start = row * Q6_K_ROW_STRIDE + sb_idx * Q6_K_BLOCK_BYTES;

    uint h2    = elem_in_sb / 128u;
    uint l    = elem_in_sb % 128u;
    uint quad = l / 32u;
    uint w    = l % 32u;
    uint is   = w / 16u;

    uint ql_byte = uint(emb.data[block_start + h2 * 64u + ((quad == 1u || quad == 3u) ? (w + 32u) : w)]);
    uint qh_byte = uint(emb.data[block_start + 128u + h2 * 32u + w]);

    uint low4  = ((quad == 2u || quad == 3u) ? (ql_byte >> 4u) : (ql_byte & 0x0Fu));
    uint high2 = (qh_byte >> (quad * 2u)) & 3u;

    int q6 = int(low4 | (high2 << 4u)) - 32;

    float d = f16tof32_from_bytes(emb.data[block_start + 208u], emb.data[block_start + 209u]);
    int sc_byte = int(emb.data[block_start + 192u + h2 * 8u + is + quad * 2u]);
    if (sc_byte >= 128) sc_byte -= 256;  // explicit sign extension
    float scale = float(sc_byte);

    return d * scale * float(q6);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= D) return;
    uint row = uint(pc.token_id);
    hidden_out.y[idx] = float16_t(emb_dequant_q6_k(row, idx) * pc.embedding_scale);
}
