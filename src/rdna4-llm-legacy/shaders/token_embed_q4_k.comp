#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int8    : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16   : require  
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float32 : require
#extension GL_KHR_shader_subgroup_basic                    : require
#extension GL_KHR_shader_subgroup_arithmetic               : require
#extension GL_KHR_shader_subgroup_shuffle                  : require
#extension GL_KHR_shader_subgroup_ballot                   : require
#extension GL_KHR_shader_subgroup_clustered                : require
#extension GL_EXT_subgroup_size_control : enable
#extension GL_EXT_nonuniform_qualifier                     : require
#extension GL_EXT_scalar_block_layout                      : require
#extension GL_EXT_shader_8bit_storage                      : require
#extension GL_EXT_shader_16bit_storage                     : require
#extension GL_KHR_memory_scope_semantics                   : require

layout(local_size_x_id = 1, local_size_y = 1, local_size_z = 1) in;
#define CUSTOM_IO_BINDINGS
#include "common.glsl"

// Q4_K token embedding: reads the quantized token_embd.weight (block_q4_K) from
// set1 binding 0 and dequants each element to fp16 output.

layout(set = IO_SET, binding = BINDING_HIDDEN_IN, scalar) readonly buffer EmbBuf { uint8_t data[]; } emb;
layout(set = IO_SET, binding = BINDING_HIDDEN_OUT, scalar)          buffer OutBuf { float16_t y[]; } hidden_out;

#define Q4_K_BLOCK_BYTES  144u
#define Q4_K_BLOCKS_PER_D (D / 256u)
#define Q4_K_ROW_STRIDE   (Q4_K_BLOCKS_PER_D * Q4_K_BLOCK_BYTES)

float emb_dequant_q4_k(uint row, uint idx) {
    uint sb_idx     = idx / 256u;
    uint elem_in_sb = idx % 256u;
    uint block_start = row * Q4_K_ROW_STRIDE + sb_idx * Q4_K_BLOCK_BYTES;

    uint group = elem_in_sb / 64u;
    uint sub   = elem_in_sb & 63u;
    uint sc_idx = group * 2u + (sub >= 32u ? 1u : 0u);

    uint qs_byte = uint(emb.data[block_start + 16u + group * 32u + (sub & 31u)]);
    uint q4      = (sub >= 32u) ? (qs_byte >> 4u) : (qs_byte & 0x0Fu);

    uint sc, m;
    if (sc_idx < 4u) {
        sc = uint(emb.data[block_start + 4u + sc_idx]) & 0x3Fu;
        m  = uint(emb.data[block_start + 8u + sc_idx]) & 0x3Fu;
    } else {
        sc = (uint(emb.data[block_start + 8u + sc_idx]) & 0x0Fu)
           | ((uint(emb.data[block_start + sc_idx]) >> 6u) << 4u);
        m  = (uint(emb.data[block_start + 8u + sc_idx]) >> 4u)
           | ((uint(emb.data[block_start + 4u + sc_idx]) >> 6u) << 4u);
    }

    float d  = f16tof32_from_bytes(emb.data[block_start], emb.data[block_start + 1u]);
    float dm = f16tof32_from_bytes(emb.data[block_start + 2u], emb.data[block_start + 3u]);

    return d * float(sc) * float(q4) - dm * float(m);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= D) return;
    uint row = uint(pc.token_id);
    hidden_out.y[idx] = float16_t(emb_dequant_q4_k(row, idx) * pc.embedding_scale);
}
