#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int8    : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16   : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float32 : require
#extension GL_KHR_shader_subgroup_basic                    : require
#extension GL_KHR_shader_subgroup_arithmetic               : require
#extension GL_KHR_shader_subgroup_shuffle                  : require
#extension GL_KHR_shader_subgroup_ballot                   : require
#extension GL_KHR_shader_subgroup_clustered                : require
#extension GL_EXT_subgroup_size_control : enable
#extension GL_EXT_nonuniform_qualifier                     : require
#extension GL_EXT_scalar_block_layout                      : require
#extension GL_EXT_shader_8bit_storage                      : require
#extension GL_EXT_shader_16bit_storage                     : require
#extension GL_KHR_memory_scope_semantics                   : require

layout(local_size_x_id = 1, local_size_y = 1, local_size_z = 1) in;

#include "common.glsl"

// RMS-norm over the full D-dimensional residual stream: attn_norm (norm_type
// 0), ffn_norm (1), output_norm (2). Single workgroup, strided reduction over
// D elements. Per-head Q/K norm (Qwen3-style) is a DIFFERENT shader now --
// see qk_norm.comp -- pulled out because bolting a second, differently-shaped
// per-head mode onto this D-wide shader (as norm_type 3/4 previously did) was
// exactly the kind of fused, hard-to-verify branch that caused real bugs this
// session; this shader now does exactly one thing (normalize D elements).

#define MAX_SUBGROUPS 16
shared float s_subgroup_sums[MAX_SUBGROUPS];

void main() {
    uint tid = gl_GlobalInvocationID.x;

    uint norm_offset;
    if (pc.norm_type == 0u) {
        norm_offset = pc.attn_norm_offset;
    } else if (pc.norm_type == 1u) {
        norm_offset = pc.ffn_norm_offset;
    } else {
        norm_offset = pc.output_norm_offset;
    }

    // ── Step 1: Strided squared-sum accumulation ──────────────────────────
    uint lane_id        = gl_SubgroupInvocationID;
    uint subgroup_id    = gl_SubgroupID;
    uint num_subgroups  = WG_SIZE_X / SUBGROUP_SIZE;

    float local_sq_sum = 0.0;
    for (uint k = tid; k < D; k += WG_SIZE_X) {
        float val = float(hidden_in.x[k]);
        local_sq_sum += val * val;
    }

    // ── Step 2: Subgroup reduction of squared sum ────────────────────────
    float sg_sum_sq = warpReduceSum(local_sq_sum);

    // ── Step 3: Cross-subgroup reduction (via LDS if > 1 subgroup) ───────
    float total_sum_sq;

    if (num_subgroups == 1u) {
        total_sum_sq = sg_sum_sq;
    } else {
        if (lane_id == 0u) {
            s_subgroup_sums[subgroup_id] = sg_sum_sq;
        }
        barrier();
        memoryBarrierShared();

        float local_sum = 0.0;
        if (subgroup_id == 0u) {
            for (uint i = lane_id; i < num_subgroups; i += SUBGROUP_SIZE) {
                local_sum += s_subgroup_sums[i];
            }
            total_sum_sq = warpReduceSum(local_sum);
        }

        barrier();
        memoryBarrierShared();

        if (subgroup_id == 0u && lane_id == 0u) {
            s_subgroup_sums[0] = total_sum_sq;
        }
        barrier();
        memoryBarrierShared();
        total_sum_sq = s_subgroup_sums[0];
    }

    // ── Step 4: Compute inverse RMS ────────────────────────────────────────
    float denom = total_sum_sq / float(D) + pc.norm_eps;
    float inv_rms = (denom > 0.0 && denom == denom) ? inversesqrt(denom) : 0.0;

    // ── Step 5: Strided output write ───────────────────────────────────────
    for (uint k = tid; k < D; k += WG_SIZE_X) {
        float w = read_layer_f16(norm_offset + k * 2u);
        float val = float(hidden_in.x[k]);
        hidden_out.y[k] = float16_t(val * inv_rms * w);
    }
}
