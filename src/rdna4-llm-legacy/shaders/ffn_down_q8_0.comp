#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int8    : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16   : require  
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float32 : require
#extension GL_KHR_shader_subgroup_basic                    : require
#extension GL_KHR_shader_subgroup_arithmetic               : require
#extension GL_KHR_shader_subgroup_shuffle                  : require
#extension GL_KHR_shader_subgroup_ballot                   : require
#extension GL_KHR_shader_subgroup_clustered                : require
#extension GL_EXT_subgroup_size_control : enable
#extension GL_EXT_nonuniform_qualifier                     : require
#extension GL_EXT_scalar_block_layout                      : require
#extension GL_EXT_shader_8bit_storage                      : require
#extension GL_EXT_shader_16bit_storage                     : require
#extension GL_KHR_memory_scope_semantics                   : require

layout(local_size_x_id = 1, local_size_y = 1, local_size_z = 1) in;

#include "common.glsl"

#define Q80_BLOCK_BYTES    34u
#define Q80_BLOCKS_PER_D   (D / 32u)
#define Q80_ROW_STRIDE     (Q80_BLOCKS_PER_D * Q80_BLOCK_BYTES)

#define Q_BYTES     (N_HEADS * HEAD_DIM * Q80_ROW_STRIDE)
#define K_BYTES     (N_KV_HEADS * HEAD_DIM * Q80_ROW_STRIDE)
#define V_BYTES     (N_KV_HEADS * HEAD_DIM * Q80_ROW_STRIDE)
#define O_ROW_STRIDE ((N_HEADS * HEAD_DIM / 32u) * Q80_BLOCK_BYTES)
#define O_BYTES     (D * O_ROW_STRIDE)
#define NORM_BYTES  (D * 2u)
#define GATE_BYTES  (FFN_DIM * Q80_ROW_STRIDE)
#define UP_BYTES    (FFN_DIM * Q80_ROW_STRIDE)

#define DOWN_BLOCKS_PER_FFN  (FFN_DIM / 32u)
#define DOWN_ROW_STRIDE      (DOWN_BLOCKS_PER_FFN * Q80_BLOCK_BYTES)
#define QK_NORM_BYTES        (HEAD_DIM * 2u)
#define DOWN_BASE          pc.down_offset

float read_down_q80(uint base, uint row, uint col) {
    uint block_idx     = col / 32u;
    uint elem_in_block = col & 31u;
    uint block_start   = base + row * DOWN_ROW_STRIDE + block_idx * Q80_BLOCK_BYTES;
    return dequant_q8_0(block_start, elem_in_block);
}

void main() {
    uint out_row = gl_WorkGroupID.x * (WG_SIZE_X / SUBGROUP_SIZE) + gl_SubgroupID;
    uint lane_id = gl_SubgroupInvocationID;

    if (out_row >= D) return;

    float accum = 0.0;
    for (uint k = lane_id; k < FFN_DIM; k += SUBGROUP_SIZE) {
        float x = float(scratch.s[k]);
        accum += x * read_down_q80(DOWN_BASE, out_row, k);
    }

    float projected = warpReduceSum(accum);
    float residual  = float(hidden_out.y[out_row]);

    if (lane_id == 0u) {


        hidden_out.y[out_row] = float16_t(projected * pc.residual_scale + residual);


    }
}
