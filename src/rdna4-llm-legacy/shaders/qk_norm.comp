#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int8    : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16   : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float32 : require
#extension GL_KHR_shader_subgroup_basic                    : require
#extension GL_KHR_shader_subgroup_arithmetic               : require
#extension GL_EXT_subgroup_size_control : enable
#extension GL_EXT_nonuniform_qualifier                     : require
#extension GL_EXT_scalar_block_layout                      : require
#extension GL_EXT_shader_8bit_storage                      : require
#extension GL_EXT_shader_16bit_storage                     : require
#extension GL_KHR_memory_scope_semantics                   : require

layout(local_size_x_id = 1, local_size_y = 1, local_size_z = 1) in;

#include "common.glsl"

// Qwen3-style per-head Q/K RMS norm: applied to the raw QKV-projection output
// in qkv_buf, AFTER the projection matmul but BEFORE RoPE. Pulled out of the
// generic multi-purpose rms_norm.comp (which also handles attn_norm/ffn_norm/
// output_norm over the full D-dimensional residual stream) into its own
// dedicated shader -- same reasoning as rope.comp's extraction: a single
// shader juggling five different norm_type branches (three D-wide, two
// per-head) is exactly the kind of fused-and-hard-to-verify code that caused
// the RoPE and attn_output bugs found this session. This shader does exactly
// one thing: normalize one head's HEAD_DIM elements.
//
// qkv_buf layout: [Q: N_HEADS*HEAD_DIM | K: N_KV_HEADS*HEAD_DIM | V: ...].
// One workgroup per (Q head | KV head), matching rope.comp's dispatch shape:
// workgroups [0, N_HEADS) normalize Q heads; workgroups [N_HEADS, N_HEADS+N_KV_HEADS)
// normalize K heads. V is never normalized.

#define MAX_SUBGROUPS_QKN 16
shared float s_partial[MAX_SUBGROUPS_QKN];

void main() {
    uint wg = gl_WorkGroupID.x;
    uint base_elem;
    uint norm_offset;

    if (wg < N_HEADS) {
        base_elem   = wg * HEAD_DIM;
        norm_offset = pc.q_norm_offset;
    } else {
        uint kv_head = wg - N_HEADS;
        if (kv_head >= N_KV_HEADS) return;
        base_elem   = N_HEADS * HEAD_DIM + kv_head * HEAD_DIM;
        norm_offset = pc.k_norm_offset;
    }

    uint tid       = gl_LocalInvocationID.x;
    uint lane_id   = gl_SubgroupInvocationID;
    uint sg_id     = gl_SubgroupID;
    uint num_sg    = WG_SIZE_X / SUBGROUP_SIZE;

    // ── Sum of squares over this head's HEAD_DIM elements ──────────────────
    float local_sq_sum = 0.0;
    for (uint k = tid; k < HEAD_DIM; k += WG_SIZE_X) {
        float v = float(hidden_out.y[base_elem + k]);
        local_sq_sum += v * v;
    }
    float sg_sum_sq = warpReduceSum(local_sq_sum);

    float total_sum_sq;
    if (num_sg == 1u) {
        total_sum_sq = sg_sum_sq;
    } else {
        if (lane_id == 0u) {
            s_partial[sg_id] = sg_sum_sq;
        }
        barrier();
        memoryBarrierShared();

        if (sg_id == 0u) {
            float acc = 0.0;
            for (uint s = lane_id; s < num_sg; s += SUBGROUP_SIZE) {
                acc += s_partial[s];
            }
            acc = warpReduceSum(acc);
            if (lane_id == 0u) {
                s_partial[0] = acc;
            }
        }
        barrier();
        memoryBarrierShared();
        total_sum_sq = s_partial[0];
    }

    float denom   = total_sum_sq / float(HEAD_DIM) + pc.norm_eps;
    float inv_rms = (denom > 0.0 && denom == denom) ? inversesqrt(denom) : 0.0;

    // ── Normalize in place ──────────────────────────────────────────────────
    for (uint k = tid; k < HEAD_DIM; k += WG_SIZE_X) {
        float w = read_layer_f16(norm_offset + k * 2u);
        float v = float(hidden_out.y[base_elem + k]);
        hidden_out.y[base_elem + k] = float16_t(v * inv_rms * w);
    }
}
