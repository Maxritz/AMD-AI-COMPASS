#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int8    : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16   : require  
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float32 : require
#extension GL_KHR_shader_subgroup_basic                    : require
#extension GL_KHR_shader_subgroup_arithmetic               : require
#extension GL_KHR_shader_subgroup_shuffle                  : require
#extension GL_KHR_shader_subgroup_ballot                   : require
#extension GL_KHR_shader_subgroup_clustered                : require
#extension GL_EXT_subgroup_size_control : enable
#extension GL_EXT_nonuniform_qualifier                     : require
#extension GL_EXT_scalar_block_layout                      : require
#extension GL_EXT_shader_8bit_storage                      : require
#extension GL_EXT_shader_16bit_storage                     : require
#extension GL_KHR_memory_scope_semantics                   : require

layout(local_size_x_id = 1, local_size_y = 1, local_size_z = 1) in;

#include "common.glsl"

// O's weight matrix is [D rows, N_HEADS*HEAD_DIM cols] (projects the
// concatenated attention heads back down to D) -- row width is N_HEADS*HEAD_DIM,
// not D. Using D (copy-pasted from the QKV shaders where D is the correct row
// width) is invisible when N_HEADS*HEAD_DIM==D but corrupts every row after
// row 0 when they differ (Qwen3-4B, MiniCPM, etc).
#define FP16_ROW_STRIDE    (N_HEADS * HEAD_DIM * 2u)
#define Q_BYTES            (N_HEADS * HEAD_DIM * FP16_ROW_STRIDE)
#define K_BYTES            (N_KV_HEADS * HEAD_DIM * FP16_ROW_STRIDE)
#define V_BYTES            (N_KV_HEADS * HEAD_DIM * FP16_ROW_STRIDE)

#define O_BASE  pc.o_offset

float read_f16_weight(uint base, uint row, uint col) {
    uint off = base + row * FP16_ROW_STRIDE + col * 2u;
    return f16tof32_from_bytes(weight_array[nonuniformEXT(pc.layer_idx)].data[off], weight_array[nonuniformEXT(pc.layer_idx)].data[off + 1u]);
}

void main() {
    // One output row per SUBGROUP (see lm_head_fp16.comp for why).
    uint lane_id = gl_SubgroupInvocationID;
    uint out_row = gl_WorkGroupID.x * (WG_SIZE_X / SUBGROUP_SIZE) + gl_SubgroupID;

    if (out_row >= D) return;

    float accum = 0.0;
    for (uint k = lane_id; k < N_HEADS * HEAD_DIM; k += SUBGROUP_SIZE) {
        float x = float(hidden_in.x[k]);
        accum += x * read_f16_weight(O_BASE, out_row, k);
    }

    float projected = warpReduceSum(accum);
    if (lane_id == 0u) {
        // Residual = pre-attention layer input, passed via the scratch (set1 binding 4)
        // slot. For layer 0 that is the embedding; for layer l it is layer l-1's output.
        float residual  = float(scratch.s[out_row]);
        hidden_out.y[out_row] = float16_t(projected * pc.residual_scale + residual);
    }
}
