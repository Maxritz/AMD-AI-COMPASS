#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int8    : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16   : require  
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float32 : require
#extension GL_KHR_shader_subgroup_basic                    : require
#extension GL_KHR_shader_subgroup_arithmetic               : require
#extension GL_KHR_shader_subgroup_shuffle                  : require
#extension GL_KHR_shader_subgroup_ballot                   : require
#extension GL_KHR_shader_subgroup_clustered                : require
#extension GL_EXT_subgroup_size_control : enable
#extension GL_EXT_nonuniform_qualifier                     : require
#extension GL_EXT_scalar_block_layout                      : require
#extension GL_EXT_shader_8bit_storage                      : require
#extension GL_EXT_shader_16bit_storage                     : require
#extension GL_KHR_memory_scope_semantics                   : require

layout(local_size_x_id = 1, local_size_y = 1, local_size_z = 1) in;

#define CUSTOM_OUTPUT_BUF
#include "common.glsl"

layout(set = IO_SET, binding = BINDING_HIDDEN_OUT, scalar)          buffer OutputBuf { float    y[]; } hidden_out;

#define Q80_BLOCK_BYTES     34u
#define Q80_BLOCKS_PER_D    (D / 32u)
#define Q80_ROW_STRIDE      (Q80_BLOCKS_PER_D * Q80_BLOCK_BYTES)
#define OUTPUT_BASE         0u

float read_q80_w(uint base, uint row, uint col) {
    uint block_idx     = col / 32u;
    uint elem_in_block = col & 31u;
    uint block_start   = base + row * Q80_ROW_STRIDE + block_idx * Q80_BLOCK_BYTES;
    return dequant_q8_0(block_start, elem_in_block);
}

void main() {
    // One output ROW per SUBGROUP (same as attn_qkv/attn_output/ffn): all 32 lanes
    // reduce the dot for a SINGLE row. A one-thread-per-row layout + warpReduceSum
    // mixes the partial dots of 32 different rows -> every logit identical.
    uint out_row = gl_WorkGroupID.x * (WG_SIZE_X / SUBGROUP_SIZE) + gl_SubgroupID;
    uint lane_id = gl_SubgroupInvocationID;

    if (out_row >= VOCAB_SIZE) return;

    float accum = 0.0;
    for (uint k = lane_id; k < D; k += SUBGROUP_SIZE) {
        float x = float(hidden_in.x[k]);
        accum += x * read_q80_w(OUTPUT_BASE, out_row, k);
    }

    float result = warpReduceSum(accum);
    if (lane_id == 0u) {
        hidden_out.y[out_row] = result * pc.logit_scale;
    }
}
