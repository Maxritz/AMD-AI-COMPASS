#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int8    : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16   : require  
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float32 : require
#extension GL_KHR_shader_subgroup_basic                    : require
#extension GL_KHR_shader_subgroup_arithmetic               : require
#extension GL_KHR_shader_subgroup_shuffle                  : require
#extension GL_KHR_shader_subgroup_ballot                   : require
#extension GL_KHR_shader_subgroup_clustered                : require
#extension GL_EXT_subgroup_size_control : enable
#extension GL_EXT_nonuniform_qualifier                     : require
#extension GL_EXT_scalar_block_layout                      : require
#extension GL_EXT_shader_8bit_storage                      : require
#extension GL_EXT_shader_16bit_storage                     : require
#extension GL_KHR_memory_scope_semantics                   : require

layout(local_size_x_id = 1, local_size_y = 1, local_size_z = 1) in;

#include "common.glsl"

// ─── Shared Memory (LDS) ────────────────────────────────────────────────────
// Maximum sequence length for score buffer (4096 → 16KB)
#define SCORE_LDS_SIZE MAX_SEQ_LEN

shared float s_scores[SCORE_LDS_SIZE];
shared float s_max_val;
shared float s_sum_exp;
shared float s_subgroup_temp[16];  // for cross-subgroup reductions

void main() {
    uint head_idx   = gl_WorkGroupID.x;
    uint thread_id  = gl_LocalInvocationID.x;
    uint lane_id    = gl_SubgroupInvocationID;
    uint sg_id      = gl_SubgroupID;
    uint num_sg     = WG_SIZE_X / SUBGROUP_SIZE;  // 4 (RDNA4) or 2 (RDNA2)

    if (head_idx >= N_HEADS) return;

    // ─── GQA Mapping ─────────────────────────────────────────────────────
    uint kv_head = (head_idx * N_KV_HEADS) / N_HEADS;

    // ─── Step 1: Load Q[head] (each lane handles dims {lane, lane+32, ...}) ──
    // Q is stored contiguously: [head_0_dim0..dim127 | head_1_dim0..dim127 | ...]

    uint seq_len = pc.seq_len;

    // ─── Step 2: Score all KV positions ───────────────────────────────────
    // One SUBGROUP per position: all 32 lanes compute the Q·K dot for a single
    // position (lane l covers dims {l, l+32, ...}), then warpReduceSum reduces
    // WITHIN that position. A layout where lanes hold DIFFERENT positions and
    // reduce together mixes their scores — as seq_len grows the mixed scores
    // overflow exp() in softmax -> NaN.
    //
    // Subgroup sg handles positions {sg, sg+num_sg, sg+2*num_sg, ...} serially.

    for (uint p = sg_id; p < seq_len; p += num_sg) {
        float qk_partial = 0.0;
        for (uint k = lane_id; k < HEAD_DIM; k += SUBGROUP_SIZE) {
            float q_val   = float(hidden_in.x[head_idx * HEAD_DIM + k]);
            uint k_offset = kv_cache_page_offset(kv_head, p, k, false);
            float16_t k_val = k_cache.k[k_offset];
            qk_partial += q_val * float(k_val);
        }
        // All 32 lanes active: reduce over the head_dim for THIS position only.
        float sg_dot = warpReduceSum(qk_partial);
        if (lane_id == 0u) {
            s_scores[p] = sg_dot * pc.attn_scale;
        }
    }

    barrier();
    memoryBarrierShared();

    // ─── Step 3: Online Softmax ───────────────────────────────────────────
    // Phase 3a: Find the maximum score across all valid positions

    float local_max = -1.0e30;
    for (uint pos = thread_id; pos < seq_len; pos += WG_SIZE_X) {
        local_max = max(local_max, s_scores[pos]);
    }
    float sg_max = warpReduceMax(local_max);

    float wg_max;
    if (num_sg == 1u) {
        wg_max = sg_max;
    } else {
        if (lane_id == 0u) {
            s_subgroup_temp[sg_id] = sg_max;
        }
        barrier();
        memoryBarrierShared();

        wg_max = -1.0e30;
        if (sg_id == 0u) {
            for (uint s = lane_id; s < num_sg; s += SUBGROUP_SIZE) {
                wg_max = max(wg_max, s_subgroup_temp[s]);
            }
            wg_max = warpReduceMax(wg_max);
            if (lane_id == 0u) {
                s_max_val = wg_max;
            }
        }
        barrier();
        memoryBarrierShared();
        wg_max = s_max_val;
    }

    // Phase 3b: Compute exp(score - max) and accumulate sum

    float local_sum = 0.0;
    for (uint pos = thread_id; pos < seq_len; pos += WG_SIZE_X) {
        float prob = exp(s_scores[pos] - wg_max);
        s_scores[pos] = prob;  // reuse LDS for probs
        local_sum += prob;
    }
    float sg_sum = warpReduceSum(local_sum);

    float wg_sum;
    if (num_sg == 1u) {
        wg_sum = sg_sum;
    } else {
        if (lane_id == 0u) {
            s_subgroup_temp[sg_id] = sg_sum;
        }
        barrier();
        memoryBarrierShared();

        wg_sum = 0.0;
        if (sg_id == 0u) {
            for (uint s = lane_id; s < num_sg; s += SUBGROUP_SIZE) {
                wg_sum += s_subgroup_temp[s];
            }
            wg_sum = warpReduceSum(wg_sum);
            if (lane_id == 0u) {
                s_sum_exp = wg_sum;
            }
        }
        barrier();
        memoryBarrierShared();
        wg_sum = s_sum_exp;
    }

    float inv_sum = 1.0 / wg_sum;

    // Phase 3c: Normalize probs in-place
    for (uint pos = thread_id; pos < seq_len; pos += WG_SIZE_X) {
        s_scores[pos] *= inv_sum;
    }
    barrier();
    memoryBarrierShared();

    // ─── Step 4: Weighted V-summation ─────────────────────────────────────
    // output[dim] = sum over pos: prob[pos] * V[pos][dim]
    // Each thread handles one dimension of the output.
    // The output dimension = HEAD_DIM elements.

    float out_accum = 0.0;
    if (thread_id < HEAD_DIM) {
        for (uint pos = 0u; pos < seq_len; pos++) {
            float prob = s_scores[pos];
            uint v_offset = kv_cache_page_offset(kv_head, pos, thread_id, true);
            float16_t v_val = v_cache.v[v_offset];
            out_accum += prob * float(v_val);
        }
    }

    // ─── Step 5: Write attention output ───────────────────────────────────
    // Output layout: [head_0 | head_1 | ... | head_N-1]
    if (thread_id < HEAD_DIM) {
        hidden_out.y[head_idx * HEAD_DIM + thread_id] = float16_t(out_accum);
    }
}
