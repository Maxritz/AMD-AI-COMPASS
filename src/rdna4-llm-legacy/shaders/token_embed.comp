#define QUANT_FP16

layout(local_size_x_id = 1, local_size_y = 1, local_size_z = 1) in;
#include "common.glsl"

// Token embedding: copies row `pc.token_id` from the embedding table
// (bound as hidden_in, set1 binding 0) to hidden_out (hidden_buf[0]).
// A pure COMPUTE op — a vkCmdCopyBuffer followed by a compute read is NOT
// reliably synchronized on RDNA4's compute queue, so do it in-shader.
void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= D) return;

    uint src = uint(pc.token_id) * D + idx;
    hidden_out.y[idx] = float16_t(float(hidden_in.x[src]) * pc.embedding_scale);
}
