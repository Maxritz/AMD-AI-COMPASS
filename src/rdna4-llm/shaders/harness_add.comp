#version 460
#extension GL_EXT_scalar_block_layout : require

// Phase 0 harness shader: proves the whole compute round-trip (buffer upload
// -> dispatch -> buffer download) works before any model logic exists.
// c[i] = a[i] + b[i], one thread per element.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, scalar) readonly buffer A { float a[]; };
layout(set = 0, binding = 1, scalar) readonly buffer B { float b[]; };
layout(set = 0, binding = 2, scalar) writeonly buffer C { float c[]; };

layout(push_constant) uniform PC { uint n; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    c[i] = a[i] + b[i];
}
