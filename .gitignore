# Environment and secrets
.env
*.env
!*.env.template
kernel-agent/env.sh
framework-agent/scripts/env.sh

# Dependency checkout cache (deps_cache_root default: $REPO_ROOT/.cache)
.cache/

# RDNA4 port clones (cloned from Maxritz forks, not synced to git)
external/rdna4-ports/

# opencode plugin node_modules
.opencode/node_modules/

# local opencode config + skills (not part of the toolkit repo)
.opencode/
opencode.json

# Vulkan LLM engine build artifacts
src/rdna4-llm/build/
src/rdna4-llm-legacy/build/

# graphify knowledge-graph caches (regenerated, never commit)
**/graphify-out/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# Wheel build output (scripts/build_wheel.sh, python -m build)
/build/
/dist/

# Large trace / profile files (regenerated by the agent)
*.trace.json
*.trace.json.gz
*.prof
*.hprof
trace_rank*.json
.rocprofv3/

# Optimization run artifacts (runtime per-session output; ignored).
optimizer_runs/*
optimization_logs/
optimization_reports/
optimized_versions/
benchmarks/
benchmark_runs/
kernel-agent/runs/
inference_optimizer/runs/
.optimization_strategies.md
optimization_report.md
bench.py
src/hyperloom/framework-agent/kb/framework_optimization/lessons.jsonl

# Benchmark / validation scratch at repo root (machine-specific).
hip_tracer.exp
hip_tracer.lib
req_*.json
resp_*.json
/validation_log.txt
/bench_multi_final.log
/VP_VULKANINFO_*.json
validate_output.txt
validate_stdout.txt
validate_stderr.txt

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test / coverage artifacts
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/

# Logs
*.log

# Skill run results (large, regenerated by agent)
.cursor/skills/*/results/

# PR description scratchpads and local review notes.
pr.md
pr_*.md
Specialist.discuss.md
specialist.discuss*.md
specialist.info.md

# F0/F1 integration: keep test baselines, dry-run merge maps, and
# archived regression sweeps tracked.
!docs/test-baselines/*.log
!docs/integration/*.log
!docs/integration/logs/*.log

# claude files
*.claude
CLAUDE.md

# temp file
code_functions_guidance_v2
.gen_funcdocs.wf.js
.gen_funcdocs_reboot.wf.js
evaluation_analysis


# AMD Radeon Developer Tool Suite (large third-party binaries, never sync)
RadeonDeveloperToolSuite-*/

# Operator runtime env (contains real API keys — never commit)
runtime-env/

# Personal per-operator launch/resume scratch scripts (worktree- and
# framework-specific; not part of the product). Keep them out of the repo.
run_kernel_forge.sh
resume_kernel_forge.sh
